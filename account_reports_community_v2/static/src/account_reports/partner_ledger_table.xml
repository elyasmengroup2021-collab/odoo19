<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="account_reports_community_v2.PartnerLedgerLines">
        <t t-foreach="lines" t-as="line" t-key="line.id">
            <t t-if="line.is_total">
                <tr class="o_account_reports_community_v2_total_row">
                    <td colspan="4"><strong t-esc="line.name"/></td>
                    <td class="text-end"><strong t-esc="this.formatAmount(line.total_debit)"/></td>
                    <td class="text-end"><strong t-esc="this.formatAmount(line.total_credit)"/></td>
                    <td class="text-end"><strong t-esc="this.formatAmount(line.closing_balance)"/></td>
                </tr>
            </t>
            <t t-if="!line.is_total">
            <tr class="o_account_reports_community_v2_gl_account_row">
                <td colspan="4">
                    <span class="o_account_reports_community_v2_caret" t-on-click="() => this.togglePartnerLedgerPartner(line)">
                        <i class="fa fa-fw" t-att-class="line.unfolded ? 'fa-caret-down' : 'fa-caret-right'"/>
                    </span>
                    <strong t-esc="line.name"/>
                    <span class="o_account_reports_community_v2_kebab ms-1"
                          title="All Journal Items"
                          t-on-click.stop="() => this.onOpenPartnerJournalItems(line)">
                        <i class="fa fa-list-alt"/>
                    </span>
                </td>
                <td class="text-end" t-esc="this.formatAmount(line.total_debit)"/>
                <td class="text-end" t-esc="this.formatAmount(line.total_credit)"/>
                <td class="text-end" t-esc="this.formatAmount(line.closing_balance)"/>
            </tr>
            <t t-if="line.unfolded">
                <tr class="o_account_reports_community_v2_partner_initial_balance_row">
                    <td colspan="4" class="text-end"><strong>Initial Balance</strong></td>
                    <td class="text-end" t-esc="this.formatAmount(line.opening_debit)"/>
                    <td class="text-end" t-esc="this.formatAmount(line.opening_credit)"/>
                    <td class="text-end" t-esc="this.formatAmount(line.opening_balance)"/>
                </tr>
                <tr t-foreach="line.aml_rows" t-as="row" t-key="row.id">
                    <td t-esc="this.formatDateValue(row.date)"/>
                    <td>
                        <a href="#" t-on-click.prevent="() => this.onOpenMove(row)" t-esc="row.move_name"/>
                    </td>
                    <td t-esc="row.account"/>
                    <td>
                        <t t-esc="row.label"/>
                        <small t-if="row.foreign_currency_name" class="text-muted d-block">
                            <t t-esc="row.amount_currency.toFixed(2)"/> <t t-esc="row.foreign_currency_name"/>
                        </small>
                    </td>
                    <td class="text-end" t-esc="this.formatAmount(row.debit)"/>
                    <td class="text-end" t-esc="this.formatAmount(row.credit)"/>
                    <td class="text-end" t-esc="this.formatAmount(row.running_balance)"/>
                </tr>
                <tr t-if="line.aml_rows_has_more" class="o_account_reports_community_v2_load_more_row">
                    <td colspan="7" class="text-center">
                        <button class="btn btn-link btn-sm" t-on-click="() => this.loadMoreAmlRows(line)" t-att-disabled="state.loadingMoreLineId === line.id">
                            <t t-esc="state.loadingMoreLineId === line.id ? 'Loading...' : 'Load more'"/>
                        </button>
                    </td>
                </tr>
                <tr class="o_account_reports_community_v2_gl_closing_row">
                    <td colspan="6" class="text-end"><strong>Closing Balance</strong></td>
                    <td class="text-end"><strong t-esc="this.formatAmount(line.closing_balance)"/></td>
                </tr>
            </t>
            </t>
        </t>
    </t>

</templates>
