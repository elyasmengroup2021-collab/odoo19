<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_compensation_days_close_wizard_form" model="ir.ui.view">
        <field name="name">hr.compensation.days.close.wizard.form</field>
        <field name="model">hr.compensation.days.close.wizard</field>
        <field name="arch" type="xml">
            <form string="Close Shift Allowance Month">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="action" widget="radio"/>
                    </group>
                    <group>
                        <field name="payment_date" invisible="action != 'pay'" required="action == 'pay'"/>
                        <field name="company_id" options="{'no_create': True}"/>
                        <field name="department_id" options="{'no_create': True}"/>
                        <field name="employee_ids" widget="many2many_tags" options="{'no_create': True}" domain="[('company_id', '=', company_id)]"/>
                    </group>
                </group>
                <group>
                    <button name="action_load_balances" type="object" string="Load Balances" class="btn-secondary"/>
                </group>
                <field name="line_ids">
                    <tree editable="bottom" create="0" delete="1">
                        <field name="employee_id"/>
                        <field name="balance_days" sum="Total Days"/>
                        <field name="balance_hours" sum="Total Hours"/>
                        <field name="balance_amount" sum="Total Balance Amount"/>
                        <field name="contract_id" optional="show"/>
                        <field name="configured_allowance_unit" optional="show"/>
                        <field name="allowance_coefficient" optional="show"/>
                        <field name="hours_allowance_coefficient" optional="show"/>
                        <field name="rate" optional="show"/>
                        <field name="hourly_rate" optional="show"/>
                        <field name="days_amount" sum="Total Days Amount" optional="show"/>
                        <field name="hours_amount" sum="Total Hours Amount" optional="show"/>
                        <field name="mission_amount" sum="Total Mission Amount" optional="show"/>
                        <field name="amount" sum="Grand Total" optional="show"/>
                    </tree>
                </field>
                <group>
                    <field name="notes" placeholder="Closing notes..."/>
                </group>
                <footer>
                    <button name="action_close_month" type="object" string="Close Month" class="btn-secondary"/>
                    <button name="action_close_month_and_print" type="object" string="Close Month and Print" class="btn-primary"/>
                    <button name="action_close_month_and_export_xlsx" type="object" string="Close Month and Export Excel" class="btn-secondary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hr_compensation_days_close_wizard" model="ir.actions.act_window">
        <field name="name">Close Shift Allowance Month</field>
        <field name="res_model">hr.compensation.days.close.wizard</field>
        <field name="view_mode">form</field>
        <field name="context">{'dialog_size': 'large'}</field>
        <field name="target">new</field>
    </record>
</odoo>
