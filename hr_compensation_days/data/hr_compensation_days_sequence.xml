<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_hr_compensation_days" model="ir.sequence">
        <field name="name">Shift Allowance Days</field>
        <field name="code">hr.compensation.days</field>
        <field name="prefix">SAD/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_hr_compensation_days_batch" model="ir.sequence">
        <field name="name">Daily Shift Allowance Days</field>
        <field name="code">hr.compensation.days.batch</field>
        <field name="prefix">DSA/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
