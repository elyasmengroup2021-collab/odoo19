<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_config_settings_customer_batch" model="ir.ui.view">
        <field name="name">res.config.settings.view.customer.batch</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Customer Batch Discount" name="customer_batch_discount_settings">
                    <setting string="Customer Batch Discount Account" help="Credit account used when applying a customer batch discount.">
                        <field name="customer_batch_discount_account_id"/>
                    </setting>
                    <setting string="Customer Batch Discount Journal" help="General journal used for the standalone discount entry.">
                        <field name="customer_batch_discount_journal_id"/>
                    </setting>
                    <setting string="Consumption Source" help="Source used when rebuilding batch consumption.">
                        <field name="customer_batch_consumption_source"/>
                    </setting>
                    <setting string="Default Discount UoM" help="Optional target UoM used to normalize quantities.">
                        <field name="customer_batch_discount_uom_id"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
