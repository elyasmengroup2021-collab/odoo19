<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_customer_batch" model="ir.ui.view">
        <field name="name">account.move.form.customer.batch</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="batch_id" domain="[('partner_id', '=', commercial_partner_id), ('company_id', '=', company_id), ('state', '=', 'open')]" invisible="move_type not in ('out_invoice', 'out_refund')"/>
                <field name="batch_end_date" invisible="not batch_id"/>
            </xpath>
        </field>
    </record>
</odoo>
