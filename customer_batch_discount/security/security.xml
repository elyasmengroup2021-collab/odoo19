<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_customer_batch_user" model="res.groups">
        <field name="name">Customer Batch User</field>
    </record>

    <record id="group_customer_batch_reset" model="res.groups">
        <field name="name">Reset Customer Batch to Draft</field>
        <field name="implied_ids" eval="[(4, ref('group_customer_batch_user'))]"/>
    </record>

    <record id="group_customer_batch_manager" model="res.groups">
        <field name="name">Customer Batch Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_customer_batch_user')), (4, ref('group_customer_batch_reset'))]"/>
    </record>

    <record id="rule_customer_batch_company" model="ir.rule">
        <field name="name">Customer Batch company isolation</field>
        <field name="model_id" ref="model_customer_batch"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_customer_batch_line_company" model="ir.rule">
        <field name="name">Customer Batch line company isolation</field>
        <field name="model_id" ref="model_customer_batch_line"/>
        <field name="domain_force">[('batch_id.company_id', 'in', company_ids)]</field>
    </record>
</odoo>
