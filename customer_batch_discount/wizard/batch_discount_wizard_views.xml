<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_customer_batch_discount_wizard_form" model="ir.ui.view">
        <field name="name">customer.batch.discount.wizard.form</field>
        <field name="model">customer.batch.discount.wizard</field>
        <field name="arch" type="xml">
            <form string="Apply Customer Batch Discount">
                <group>
                    <group>
                        <field name="batch_id"/>
                        <field name="partner_id"/>
                    </group>
                    <group>
                        <field name="start_date"/>
                        <field name="end_date"/>
                    </group>
                </group>
                <group string="Same Discount For All Products">
                    <field name="discount_per_ton"/>
                    <button name="action_apply_to_all" type="object" string="Apply To All" class="btn-secondary"/>
                </group>
                <field name="line_ids">
                    <list editable="bottom" create="0" delete="0">
                        <field name="batch_line_id" column_invisible="1"/>
                        <field name="product_id"/>
                        <field name="quantity"/>
                        <field name="uom_id"/>
                        <field name="discount_per_unit"/>
                        <field name="discount_amount"/>
                    </list>
                </field>
                <group class="oe_subtotal_footer oe_right">
                    <field name="total_discount" class="oe_subtotal"/>
                </group>
                <footer>
                    <button name="action_apply_discount" type="object" string="Apply Discount" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
