<?xml version="1.0"?>
<odoo>
    <record id="customer_account_statement_view_form" model="ir.ui.view">
        <field name="name">customer.statement.wizard.form</field>
        <field name="model">customer.statement.wizard</field>
        <field name="arch" type="xml">
            <form string="Vendor Account Statement">
                <group>
                    <group>
                        <field name="date_start"/>
                        <field name="date_end"/>
                        <field name="type" widget="radio" invisible="1"/>
                    </group>
                    <group>
                        <field name="partner_id" domain="[('customer_rank','&gt;', 0)]" options="{'no_create': True, 'no_open': True}"/>
<!--                        <field name="product_id" options="{'no_create': True, 'no_open': True}"/>-->
                        <!--<field name="product_ids" widget="many2many_tags" options="{'no_create': True, 'no_open': True}"/>-->
                    </group>
                </group>
                <footer>
                    <button name="action_view_report" string="View"
                            type="object" class="btn-secondary"
                            data-hotkey="w"/>
                    <button name="action_download" string="Download"
                            type="object" class="btn-primary"
                            data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="customer_account_statement_action" model="ir.actions.act_window">
        <field name="name">Customer Account Statement</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">customer.statement.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="customer_account_statement_view_form"/>
        <field name="target">new</field>
    </record>
    <menuitem
            parent="account.menu_finance_receivables"
            id="menu_customer_account_statement"
            action="customer_account_statement_action"
            sequence="220"
            groups="account.group_account_invoice"
    />

</odoo>
