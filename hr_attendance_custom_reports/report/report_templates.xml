<odoo>
    <template id="report_layout_pro">
        <t t-set="is_ar" t-value="user.lang and user.lang.startswith('ar')"/>
        <t t-set="direction" t-value="'rtl' if is_ar else 'ltr'"/>
        <style>
            .hr-report { font-family: DejaVu Sans, Arial, sans-serif; direction: <t t-esc="direction"/>; color:#172033; font-size:10px; }
            .hr-report .header { border:1px solid #26364d; border-radius:6px; padding:12px 16px; margin-bottom:12px; background:#f4f7fb; }
            .hr-report h2 { margin:0 0 5px; color:#163a63; font-size:20px; }
            .hr-report .meta { color:#56657a; font-size:10px; }
            .hr-report table { width:100%; border-collapse:collapse; margin-top:8px; page-break-inside:auto; }
            .hr-report thead { display:table-header-group; }
            .hr-report th { background:#163a63; color:#fff; padding:7px 5px; border:1px solid #b8c5d5; text-align:center; }
            .hr-report td { padding:6px 5px; border:1px solid #c8d2df; text-align:center; }
            .hr-report tbody tr:nth-child(even) { background:#f5f8fc; }
            .hr-report .employee { margin-top:14px; padding:8px 10px; color:#fff; background:#2878a8; font-weight:bold; border-radius:4px 4px 0 0; }
            .hr-report .badge { font-weight:bold; padding:2px 5px; border-radius:3px; }
            .hr-report .present { color:#147a48; }
            .hr-report .absent { color:#b42318; }
            .hr-report .leave { color:#a15c00; }
            .hr-report .incomplete { color:#8b5cf6; }
            .hr-report .summary { margin-top:14px; padding:10px; border:1px solid #9db2ca; background:#edf5fc; border-radius:5px; }
            .hr-report .summary strong { color:#163a63; }
        </style>
    </template>

    <template id="report_movement_template">
        <t t-call="web.html_container"><t t-foreach="docs" t-as="doc"><div class="page hr-report"><t t-call="hr_attendance_custom_reports.report_layout_pro"/>
            <div class="header"><h2><t t-esc="'Employee Movement Report' if not is_ar else 'تقرير حركة الموظف'"/></h2><div class="meta"><t t-esc="'From' if not is_ar else 'من تاريخ'"/>: <t t-esc="doc.date_from"/>  -  <t t-esc="'To' if not is_ar else 'إلى تاريخ'"/>: <t t-esc="doc.date_to"/></div></div>
            <t t-set="data" t-value="doc.get_movement_data()"/>
            <t t-foreach="data" t-as="rec"><div class="employee"><t t-esc="rec['employee'].name"/> — <t t-esc="rec['employee'].barcode or rec['employee'].id"/></div><table><thead><tr><th><t t-esc="'Operational Date' if not is_ar else 'اليوم التشغيلي'"/></th><th><t t-esc="'Day' if not is_ar else 'اليوم'"/></th><th><t t-esc="'Shift' if not is_ar else 'الوردية'"/></th><th><t t-esc="'Status' if not is_ar else 'الحالة'"/></th><th><t t-esc="'In' if not is_ar else 'الحضور'"/></th><th><t t-esc="'Out' if not is_ar else 'الانصراف'"/></th><th><t t-esc="'Late' if not is_ar else 'التأخير'"/></th><th><t t-esc="'Early Out' if not is_ar else 'انصراف مبكر'"/></th><th><t t-esc="'Overtime' if not is_ar else 'إضافي'"/></th><th><t t-esc="'Hours' if not is_ar else 'الساعات'"/></th></tr></thead><tbody><t t-foreach="rec['days']" t-as="d"><tr><td><t t-esc="d['date']"/></td><td><t t-esc="d['day_name']"/></td><td><t t-esc="d['shift_name']"/></td><td t-att-class="'badge ' + ('present' if d['status']=='Present' else 'absent' if d['status']=='Absent' else 'leave' if d['status']=='On Leave' else 'incomplete')"><t t-esc="d['status']"/></td><td><t t-esc="d['check_in']"/></td><td><t t-esc="d['check_out']"/></td><td><t t-esc="d['late']"/></td><td><t t-esc="d['early']"/></td><td><t t-esc="d['overtime']"/></td><td><t t-esc="d['hours']"/></td></tr></t></tbody></table></t>
        </div></t></t>
    </template>

    <template id="report_delay_template"><t t-call="web.html_container"><t t-foreach="docs" t-as="doc"><div class="page hr-report"><t t-call="hr_attendance_custom_reports.report_layout_pro"/><div class="header"><h2><t t-esc="'Delay Report' if not is_ar else 'كشف التأخير'"/></h2><div class="meta"><t t-esc="doc.date_from"/> — <t t-esc="doc.date_to"/></div></div><t t-set="lines" t-value="doc.get_delay_data()"/><table><thead><tr><th><t t-esc="'Code' if not is_ar else 'الرقم'"/></th><th><t t-esc="'Employee' if not is_ar else 'اسم الموظف'"/></th><th><t t-esc="'Operational Date' if not is_ar else 'اليوم التشغيلي'"/></th><th><t t-esc="'Shift' if not is_ar else 'الوردية'"/></th><th><t t-esc="'Delay (min)' if not is_ar else 'التأخير بالدقائق'"/></th></tr></thead><tbody><t t-foreach="lines" t-as="l"><tr><td><t t-esc="l['code']"/></td><td><t t-esc="l['name']"/></td><td><t t-esc="l['date']"/></td><td><t t-esc="l.get('shift','')"/></td><td><t t-esc="l['delay']"/></td></tr></t></tbody></table></div></t></t></template>

    <template id="report_fingerprint_template"><t t-call="web.html_container"><t t-foreach="docs" t-as="doc"><div class="page hr-report"><t t-call="hr_attendance_custom_reports.report_layout_pro"/><div class="header"><h2><t t-esc="'Fingerprint Log' if not is_ar else 'كشف بصمات الموظفين'"/></h2><div class="meta"><t t-esc="doc.date_from"/> — <t t-esc="doc.date_to"/></div></div><t t-set="lines" t-value="doc.get_fingerprint_list_data()"/><table><thead><tr><th><t t-esc="'Operational Date' if not is_ar else 'اليوم التشغيلي'"/></th><th><t t-esc="'Time' if not is_ar else 'الوقت'"/></th><th><t t-esc="'Type' if not is_ar else 'النوع'"/></th><th><t t-esc="'Code' if not is_ar else 'الرقم'"/></th><th><t t-esc="'Employee' if not is_ar else 'اسم الموظف'"/></th><th><t t-esc="'Shift' if not is_ar else 'الوردية'"/></th></tr></thead><tbody><t t-foreach="lines" t-as="l"><tr><td><t t-esc="l['date']"/></td><td><t t-esc="l['time']"/></td><td><t t-esc="l['type']"/></td><td><t t-esc="l['code']"/></td><td><t t-esc="l['name']"/></td><td><t t-esc="l.get('shift','')"/></td></tr></t></tbody></table></div></t></t></template>

    <template id="report_absence_template"><t t-call="web.html_container"><t t-foreach="docs" t-as="doc"><div class="page hr-report"><t t-call="hr_attendance_custom_reports.report_layout_pro"/><div class="header"><h2><t t-esc="'Absence Report' if not is_ar else 'كشف الغياب'"/></h2></div><t t-set="lines" t-value="doc.get_absence_data()"/><table><thead><tr><th>Date</th><th>Code</th><th>Name</th><th>Department</th></tr></thead><tbody><t t-foreach="lines" t-as="l"><tr><td><t t-esc="l['date']"/></td><td><t t-esc="l['code']"/></td><td><t t-esc="l['name']"/></td><td><t t-esc="l['dept']"/></td></tr></t></tbody></table></div></t></t></template>
    <template id="report_single_punch_template"><t t-call="web.html_container"><t t-foreach="docs" t-as="doc"><div class="page hr-report"><t t-call="hr_attendance_custom_reports.report_layout_pro"/><div class="header"><h2><t t-esc="'Single Punch Report' if not is_ar else 'كشف البصمات المفردة'"/></h2></div><t t-set="lines" t-value="doc.get_single_punch_data()"/><table><thead><tr><th>Date</th><th>Code</th><th>Name</th><th>Shift</th><th>Time</th></tr></thead><tbody><t t-foreach="lines" t-as="l"><tr><td><t t-esc="l['date']"/></td><td><t t-esc="l['code']"/></td><td><t t-esc="l['name']"/></td><td><t t-esc="l.get('shift','')"/></td><td><t t-esc="l['time']"/></td></tr></t></tbody></table></div></t></t></template>
    <template id="report_attendance_sheet_template"><t t-call="hr_attendance_custom_reports.report_movement_template"/></template>
    <template id="report_yearly_template"><t t-call="hr_attendance_custom_reports.report_movement_template"/></template>
    <template id="report_leave_balance_template"><t t-call="web.html_container"><t t-foreach="docs" t-as="doc"><div class="page hr-report"><t t-call="hr_attendance_custom_reports.report_layout_pro"/><div class="header"><h2><t t-esc="'Leave Balance Report' if not is_ar else 'كشف أرصدة الإجازات'"/></h2></div><t t-set="lines" t-value="doc.get_leave_balance_data()"/><table><thead><tr><th>Code</th><th>Name</th><th>Department</th><th>Leave Type</th><th>Allocated</th><th>Taken</th><th>Remaining</th></tr></thead><tbody><t t-foreach="lines" t-as="l"><tr><td><t t-esc="l['code']"/></td><td><t t-esc="l['name']"/></td><td><t t-esc="l['dept']"/></td><td><t t-esc="l['leave_type']"/></td><td><t t-esc="l['allocated']"/></td><td><t t-esc="l['taken']"/></td><td><t t-esc="l['remaining']"/></td></tr></t></tbody></table></div></t></t></template>
</odoo>
